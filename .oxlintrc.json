{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "dist/",
    "tmp/",
    "out-tsc/",
    ".out",
    "node_modules/",
    "**/.claude/settings.local.json",
    ".idea/",
    ".project",
    ".classpath",
    ".c9/",
    "*.launch",
    ".settings/",
    "*.sublime-workspace",
    ".DS_Store",
    "Thumbs.db",
    "Thumbs.db:encryptable",
    "ehthumbs.db",
    "ehthumbs_vista.db",
    "._*",
    ".AppleDouble",
    ".LSOverride",
    ".DocumentRevisions-V100",
    ".fseventsd",
    ".Spotlight-V100",
    ".TemporaryItems",
    ".Trashes",
    ".VolumeIcon.icns",
    ".com.apple.timemachine.donotpresent",
    ".AppleDB",
    ".AppleDesktop",
    "Network Trash Folder",
    "Temporary Items",
    ".apdisk",
    "$RECYCLE.BIN/",
    "[Dd]esktop.ini",
    "*.lnk",
    ".env",
    ".env.test",
    ".env.production",
    ".env*.local",
    "logs",
    "*.log",
    "npm-debug.log*",
    "report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json",
    ".cache/",
    ".npm/",
    ".eslintcache",
    ".node_repl_history",
    ".fuse_hidden*",
    ".directory",
    ".Trash-*",
    ".nfs*",
    "temp/",
    "__pycache__/",
    "*.py[cod]",
    "**/venv",
    "*.tsbuildinfo",
    "*.tgz",
    "*.pid",
    "*.pid.lock",
    "pids",
    "coverage/",
    "*.lcov",
    ".claude/",
    ".mcp.json",
    ".serena/",
    ".vscode/",
    ".cursor/",
    "docs/lead-snr-engineer-test-062026.pdf"
  ]
}
