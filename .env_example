# Variables the service reads, with their defaults. Every one is optional.
# The service does not load a .env file yet - set them in the shell environment.

# Port the HTTP server listens on (REST /health and GraphQL /graphql).
PORT=4000

# `production` keeps the GraphQL schema in memory instead of writing schema.gql.
# `pnpm start:prod` sets it.
NODE_ENV=development
