# Variables the service reads, with their defaults. Every one is optional.
# The service does not load a .env file - set them in the shell environment.
# A bad value stops the service at boot with a message naming the key.

# Port the HTTP server listens on (REST /health and GraphQL /graphql).
PORT=4000

# development | production | test. `production` keeps the GraphQL schema in memory
# instead of writing schema.gql; `pnpm start:prod` sets it.
NODE_ENV=development

# libsql URL of the SQLite database; the file is created on first start.
DB_URL=file:./data/weather.sqlite

# Minutes a stored forecast is served before it is refreshed from Open-Meteo.
FORECAST_TTL_MINUTES=60

# Timeout for each call to Open-Meteo, in milliseconds.
UPSTREAM_TIMEOUT_MS=5000

# Open-Meteo base URLs. Tests point them at a local fixture server.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
