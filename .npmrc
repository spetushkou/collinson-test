# engine-strict is deliberately off: pnpm then enforces every dependency's engines
# too, and @nestjs/cli pulls in @angular-devkit/core, which demands Node ^22.22.3 and
# refuses an install on 22.22.2 even though the service runs fine there.
# package.json "engines" still declares the supported range as a warning.
engine-strict=false

# Refuse package versions younger than 7 days - most supply-chain attacks are
# caught and pulled within that window. pnpm counts minutes, npm counts days.
minimum-release-age=10080
min-release-age=7
